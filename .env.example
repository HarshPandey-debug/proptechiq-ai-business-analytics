# Google Gemini API Configuration (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# PostgreSQL Database Connection URL
# If omitted, `src/ai_analytics_assistant.py` automatically falls back to an
# in-memory relational engine populated from `data/cleaned/*.csv`.
DATABASE_URL=postgresql://username:password@localhost:5432/proptech_analytics
